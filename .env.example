# Copy this file to .env for local development.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
WEBSOCKET_SEND_TIMEOUT_SECONDS=2.0
DATABASE_URL=sqlite:///./data/interactive_live_engine.db
EVENT_RECORD_RETENTION_DAYS=7
# Optional TikTok LIVE provider. Keep disabled until a scheduled live-test session.
TIKTOK_LIVE_ENABLED=false
TIKTOK_LIVE_USERNAME=
TIKTOK_LIVE_DIAGNOSTICS_ENABLED=false

# ALTERAR .ENV PARA OS DADOS ABAIXO PARA TESTAR O PROVIDER TIKTOK LIVE
# TIKTOK_LIVE_ENABLED=true
# TIKTOK_LIVE_DIAGNOSTICS_ENABLED=true
# TIKTOK_LIVE_USERNAME=seu_usuario_sem_arroba
